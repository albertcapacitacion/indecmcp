{
  "name": "indec-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "INDEC MCP — traceable official Argentine statistics, hosted on ChatGPT Sites",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/albertcapacitacion/indecmcp.git"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx scripts/dev.ts",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:live": "node --env-file-if-exists=.env --import tsx scripts/live.ts",
    "verify:selector": "node --env-file-if-exists=.env --import tsx scripts/verify-selector.ts",
    "db:generate": "drizzle-kit generate",
    "docs:mapping": "node scripts/api-mapping.mjs",
    "package:plugin": "node scripts/package-plugin.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261102.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "22.20.5",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.4",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
